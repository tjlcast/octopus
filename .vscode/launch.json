{
    // VS Code debug configurations for local development.
    // The full-stack compound follows README_zh.md "Development Mode":
    // - frontend: cd web && pnpm install && NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8080" pnpm run dev
    // - backend: go run main.go start
    //
    // Environment variables are set through VS Code "env" so the configuration
    // works across macOS, Windows, and Linux shells.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend Debug Octopus Start",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "args": [
                "start"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "OCTOPUS_DEBUG": "true"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Frontend Debug Next Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm install && pnpm run dev",
            "windows": {
                "command": "cmd /d /c \"pnpm install && pnpm run dev\""
            },
            "cwd": "${workspaceFolder}/web",
            "env": {
                "NEXT_PUBLIC_API_BASE_URL": "http://127.0.0.1:8080",
                "OCTOPUS_API_BASE_URL": "http://127.0.0.1:8080"
            },
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}/web"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug Octopus",
            "configurations": [
                "Backend Debug Octopus Start",
                "Frontend Debug Next Dev"
            ],
            "stopAll": true
        }
    ]
}
