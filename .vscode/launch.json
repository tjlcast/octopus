{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend Debug Octopus Start",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "args": [
                "start"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "OCTOPUS_DEBUG": "true"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "showLog": true,
            "trace": "verbose"
        },
        {
            "name": "Frontend Debug Next Dev",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm dev",
            "cwd": "${workspaceFolder}/web",
            "env": {
                "OCTOPUS_API_BASE_URL": "http://localhost:8080"
            },
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "debugWithChrome",
                "webRoot": "${workspaceFolder}/web"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug Octopus",
            "configurations": [
                "Backend Debug Octopus Start",
                "Frontend Debug Next Dev"
            ],
            "stopAll": true
        }
    ]
}
