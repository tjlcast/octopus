curl -X POST http://121.40.102.152:8080/v1/chat/completions \
  -H "Content-Type: application/json" \
  -d '{
    "type": 3,
    "model": "chat",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful assistant."
      },
      {
        "role": "user",
        "content": "who are you?"
      },
      {
        "role": "assistant",
        "content": "I am a chatbot."
      }
    ],
    "temperature": 0.7,
    "max_tokens": 1000,
    "stream": true
  }'


curl -X POST http://121.40.102.152:8080/v1/chat/completions \
  -H "Authorization: Bearer apple" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "chat",
